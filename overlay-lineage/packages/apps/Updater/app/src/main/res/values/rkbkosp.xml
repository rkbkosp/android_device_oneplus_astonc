<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- OTA backend: crDroid JSON schema served by the rkbkosp host.
         {device} is replaced with ro.crdroid.device (see DeviceInfoUtils). -->
